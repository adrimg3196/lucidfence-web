# Safe public project URL. Example only; replace in Vercel.
SUPABASE_URL=https://[REDACTED].supabase.co

# Supabase publishable/anon key only. Never use service_role or sb_secret_ here.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_[REDACTED]

# FleetDM read-only UEM connector (optional). Server-side only; never exposed to the browser.
FLEET_URL=https://fleet.tuempresa.com
FLEET_API_TOKEN=[REDACTED]
# Optional: restrict to a Fleet tenant/group scope.
FLEET_FLEET_ID=
