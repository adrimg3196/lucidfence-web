# Safe public project URL. Example only; replace in Vercel.
SUPABASE_URL=https://[REDACTED].supabase.co

# Supabase publishable/anon key only. Never use service_role or sb_secret_ here.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_[REDACTED]

# Workspace UUIDs authorized to use the server-side UEM credentials.
# Required whenever any direct/gateway connector is configured; comma-separated.
UEM_ALLOWED_WORKSPACE_IDS=00000000-0000-4000-8000-000000000000

# FleetDM direct connector (optional).
FLEET_URL=https://fleet.tuempresa.com
FLEET_API_TOKEN=[REDACTED]
FLEET_FLEET_ID=

# Applivery Organizations/UEM API (optional, Bearer service account).
APPLIVERY_API_BASE=https://api.applivery.io/v1
APPLIVERY_ORG_ID=
APPLIVERY_API_KEY=[REDACTED]

# Microsoft Intune / Graph client credentials (optional, read-only permission).
INTUNE_TENANT_ID=
INTUNE_CLIENT_ID=
INTUNE_CLIENT_SECRET=[REDACTED]

# Jamf Pro API role credentials (optional, read-only role).
JAMF_BASE_URL=https://tuempresa.jamfcloud.com
JAMF_CLIENT_ID=
JAMF_CLIENT_SECRET=[REDACTED]

# Compatible BYOI gateway for Hexnode, Workspace ONE, ChromeOS or another UEM.
UEM_GATEWAY_URL=https://tu-gateway.example.com
UEM_GATEWAY_TOKEN=[REDACTED]
